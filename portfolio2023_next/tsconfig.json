{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "moduleResolution": "bundler",
    "plugins": [
      {
        "name": "next"
      },
      {
        "name": "typescript-plugin-styled-components",
        "options": {
          "ssr": true,
          "displayName": true,
          "fileName": false
        }
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "img/*": ["./public/img/*"],
      "@vercel/analytics/react": ["./node_modules/@vercel/analytics/dist/react"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "**/types/**.ts", // 프로젝트 전역 타입 정리
    "**/types/**.tsx", // 프로젝트 전역 타입 정리
    "jest.setup.js"
  ],
  "exclude": ["node_modules"]
}
