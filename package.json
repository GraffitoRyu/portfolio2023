{
  "name": "@graffitoryu/portfolio2023",
  "private": true,
  "scripts": {
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "build": "turbo build",
    "clean": "bash ./scripts/clean-package.sh",
    "clear": "bash ./scripts/clear-cache.sh",
    "prepare": "husky",
    "dev:next": "turbo dev --filter=@graffitoryu/portfolio2023-nextjs",
    "next:start": "turbo next:start",
    "dev:vite": "turbo dev --filter=@graffitoryu/portfolio2023-tanstack-router",
    "vite:preview": "turbo vite:preview"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.6",
    "turbo": "2.10.5",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*": "prettier --check --ignore-unknown",
    "apps/next/**/*.{js,jsx,ts,tsx}": "apps/next/node_modules/.bin/eslint --config apps/next/eslint.config.mjs",
    "apps/vite/**/!(*.gen).{js,jsx,ts,tsx}": "apps/vite/node_modules/.bin/eslint --config apps/vite/eslint.config.mjs",
    "packages/config-eslint/**/*.{js,jsx,ts,tsx}": "packages/config-eslint/node_modules/.bin/eslint --config packages/config-eslint/eslint.config.mjs",
    "packages/preset-config/**/*.{js,jsx,ts,tsx}": "packages/preset-config/node_modules/.bin/eslint --config packages/preset-config/eslint.config.mjs",
    "packages/preset-data/**/*.{js,jsx,ts,tsx}": "packages/preset-data/node_modules/.bin/eslint --config packages/preset-data/eslint.config.mjs",
    "packages/types/**/*.{js,jsx,ts,tsx}": "packages/types/node_modules/.bin/eslint --config packages/types/eslint.config.mjs",
    "packages/ui/**/*.{js,jsx,ts,tsx}": "packages/ui/node_modules/.bin/eslint --config packages/ui/eslint.config.mjs",
    "packages/utils/**/*.{js,jsx,ts,tsx}": "packages/utils/node_modules/.bin/eslint --config packages/utils/eslint.config.mjs"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "pnpm": "11.10.0"
  }
}
